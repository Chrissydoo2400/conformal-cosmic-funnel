import numpy as np

class CosmicFunnelSimulation:
    """
    Numerical simulator for the Conformal Cosmic Funnel & Lens Framework.
    Upgraded to support Kerr Metric backgrounds and dynamic rotation tensors.
    """
    def __init__(self, M=1.0, a=0.5, G=1.0, c=1.0):
        self.M = M      # Mass of ancestral parent black hole
        self.a = a      # Angular momentum parameter (0 <= a <= M)
        self.G = G      # Gravitational constant
        self.c = c      # Speed of light
        
        # Calculate critical Kerr geometric horizons
        self.r_plus = G * M / c**2 + np.sqrt(max(0, (G * M / c**2)**2 - a**2))
        self.r_minus = G * M / c**2 - np.sqrt(max(0, (G * M / c**2)**2 - a**2))

    def kerr_metric_tensor(self, r, theta):
        """
        Computes the covariant metric components g_mu_nu for a Kerr spacetime background.
        """
        # Intermediate structural scale factors
        sigma = r**2 + (self.a**2) * (np.cos(theta)**2)
        delta = r**2 - 2 * self.G * self.M * r / self.c**2 + self.a**2
        
        # Non-zero tensor elements
        g_tt = -(1 - (2 * self.G * self.M * r) / (sigma * self.c**2))
        g_rr = sigma / delta if delta != 0 else np.inf
        g_thth = sigma
        g_phph = (r**2 + self.a**2 + (2 * self.G * self.M * r * self.a**2 * np.sin(theta)**2) / (sigma * self.c**2)) * np.sin(theta)**2
        g_tph = -(2 * self.G * self.M * r * self.a * np.sin(theta)**2) / (sigma * self.c**2) # Frame-dragging term
        
        # 4x4 Metric Matrix representation
        g_munu = np.zeros((4, 4))
        g_munu[0, 0] = g_tt
        g_munu[1, 1] = g_rr
        g_munu[2, 2] = g_thth
        g_munu[3, 3] = g_phph
        g_munu[0, 3] = g_tph
        g_munu[3, 0] = g_tph
        
        return g_munu

    def stress_energy_tensor_pipeline(self, r, theta, rho_pipeline, P_r, J_phi, u_mu):
        """
        Constructs the upgraded Stress-Energy Tensor T_mu_nu injected pipeline.
        Incorporates continuous mass density, radial tension, and eternal rotation.
        """
        g_munu = self.kerr_metric_tensor(r, theta)
        T_munu = np.zeros((4, 4))
        
        # 1. Relativistic Fluid Kinetic Energy Core: (rho + P_phi) * u_mu * u_nu
        for mu in range(4):
            for nu in range(4):
                T_munu[mu, nu] = (rho_pipeline + abs(J_phi)) * u_mu[mu] * u_nu[nu]
                
        # 2. Add Negative Radial Pressure (Outward mechanical tension holding funnel open)
        T_munu += P_r * g_munu
        
        # 3. Inject explicit Angular Momentum Tensor components for spinning chain stability
        T_munu[3, 3] += J_phi**2  # Angular stress component
        
        return T_munu

    def verify_singularity_avoidance(self, r, theta, rho_pipeline, P_r, J_phi, u_mu):
        """
        Tests if the combination of angular momentum and negative radial pressure
        successfully breaks the Strong Energy Condition (SEC) to bypass structural collapse.
        """
        g_munu = self.kerr_metric_tensor(r, theta)
        T_munu = self.stress_energy_tensor_pipeline(r, theta, rho_pipeline, P_r, J_phi, u_mu)
        
        # Compute trace of the Stress-Energy Tensor (T)
        g_inverse = np.linalg.pinv(g_munu)
        T_trace = np.trace(np.dot(g_inverse, T_munu))
        
        # Check Strong Energy Condition criterion contraction
        sec_violated = (T_trace < 0) or (P_r < 0 and abs(J_phi) > rho_pipeline)
        return sec_violated

# Example instantiation mapping numerical validation near the horizon boundary
if __name__ == "__main__":
    # Setup test environment properties
    sim = CosmicFunnelSimulation(M=1.0, a=0.45)
    
    # Coordinates inside the ergosphere boundary layer
    test_r = sim.r_plus * 0.98  
    test_theta = np.pi / 2     # Equator plane slice
    
    # 4-Velocity vector for swirling infalling material
    u_mu_vector = np.array([1.2, -0.5, 0.0, 0.75]) 
    
    # Framework Inputs
    rho_in = 5.0     # Energy density of accreted mass
    P_radial = -6.5  # Negative outward pressure parameter (spinning chain analogy)
    J_spin = 3.2     # Angular momentum momentum pipeline injection
    
    sec_check = sim.verify_singularity_avoidance(test_r, test_theta, rho_in, P_radial, J_spin, u_mu_vector)
    
    print(f"--- Cosmic Funnel Script Test Results ---")
    print(f"Outer Horizon Boundary Coordinates (r_plus): {sim.r_plus:.4f}")
    print(f"Testing Simulation Coordinates at r = {test_r:.4f}")
    print(f"Strong Energy Condition Violated (Singularity Bypassed): {sec_check}")
